# Copy to .env and fill in real values. .env is gitignored — NEVER commit it.
# This repo is PUBLIC.

# --- Telegram (Telethon) ---
# Get API_ID / API_HASH from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# StringSession for each account (generate once, store securely — e.g. gocryptfs).
# Used by scripts/fetch_active_chats.py and scripts/fetch_messages.py via the
# --account flag (personal|work) which selects the matching prefix below.
PERSONAL_TELEGRAM_SESSION_STRING=
WORK_TELEGRAM_SESSION_STRING=

# --- OpenAI (only for scripts/transcribe_voice.py — disabled in current version) ---
OPENAI_API_KEY=
